rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'daramolapeter98@gmail.com';
    }
    function isSignedIn() {
      return request.auth != null;
    }

    function isChatParticipant(conversationId, userId) {
      let conversationPath = /databases/$(database)/documents/social_conversations/$(conversationId);
      return exists(conversationPath)
        && userId in get(conversationPath).data.participantIds;
    }

    function isUserBlockedEitherWay(userA, userB) {
      return exists(/databases/$(database)/documents/social_user_blocks/$(userA)/blocked/$(userB))
        || exists(/databases/$(database)/documents/social_user_blocks/$(userB)/blocked/$(userA));
    }

    function isChatMutedFor(conversationId, userId) {
      let settingPath = /databases/$(database)/documents/social_chat_settings/$(conversationId + '_' + userId);
      return exists(settingPath)
        && get(settingPath).data.userId == userId
        && get(settingPath).data.muted == true;
    }

    function validChatSettings(settingId, settings) {
      return settings.keys().hasOnly(['conversationId', 'userId', 'muted', 'archived', 'markedUnread', 'updatedAt'])
        && settings.keys().hasAll(['conversationId', 'userId', 'muted', 'archived', 'markedUnread', 'updatedAt'])
        && settings.conversationId is string
        && settings.userId == request.auth.uid
        && settingId == settings.conversationId + '_' + settings.userId
        && settings.muted is bool
        && settings.archived is bool
        && settings.markedUnread is bool
        && settings.updatedAt is timestamp
        && isChatParticipant(settings.conversationId, request.auth.uid);
    }

    // ─── Quizzes ────────────────────────────────────────────────────
    match /quizzes/{quizId} {
      allow read: if true;
      allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.host_uid == request.auth.uid);
      allow create: if isSignedIn();
    }

    // ─── Attempts ───────────────────────────────────────────────────
    match /attempts/{attemptId} {
      allow create: if true;
      allow read, update, delete: if isAdmin()
          || (isSignedIn() && resource.data.host_uid == request.auth.uid);
    }

    // ─── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.role == 'student'
          && request.auth.token.email_verified == true
          && request.resource.data.status == 'pending'
          && request.resource.data.registration_status == 'profile_pending'
          && request.resource.data.otp_verified == true);
      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && (
            (resource.data.registration_status == 'otp_pending'
              && request.resource.data.registration_status in ['otp_pending', 'profile_pending'])
            || (resource.data.registration_status == 'profile_pending'
              && request.resource.data.registration_status in ['profile_pending', 'complete']
              && request.resource.data.otp_verified == true)
            || (resource.data.registration_status == 'complete'
              && request.resource.data.registration_status == 'complete'
              && request.resource.data.status == resource.data.status)
          ));

      // Private StudyHub learning plans and all saved lesson/assessment progress.
      match /studyPlans/{planId} {
        function validStudyPlan(data) {
          return data.keys().hasOnly([
              'uid', 'title', 'academicCategory', 'academicLevel', 'programme', 'subject', 'courseCode', 'sourceMaterial', 'learningInstructions', 'sourceCharacterCount', 'sourceChunkCount', 'sourceName',
              'topics', 'currentTopicIndex', 'completedTopics', 'bypassedTopics', 'status',
              'createdAt', 'updatedAt'
            ])
            && data.keys().hasAll([
              'uid', 'title', 'academicCategory', 'academicLevel', 'programme', 'subject', 'courseCode', 'sourceMaterial', 'sourceCharacterCount', 'sourceChunkCount', 'sourceName',
              'topics', 'currentTopicIndex', 'completedTopics', 'bypassedTopics', 'status',
              'createdAt', 'updatedAt'
            ])
            && data.uid == userId
            && data.title is string && data.title.size() > 0 && data.title.size() <= 120
            && data.academicCategory is string && data.academicCategory.size() <= 40
            && data.academicLevel is string && data.academicLevel.size() <= 60
            && data.programme is string && data.programme.size() <= 120
            && data.subject is string
            && data.subject.size() > 0
            && data.subject.size() <= 120
            && data.courseCode is string
            && data.sourceMaterial is string
            && data.sourceMaterial.size() <= 24000
            && data.learningInstructions is string && data.learningInstructions.size() <= 4000
            && data.sourceCharacterCount is int && data.sourceCharacterCount >= 0
            && data.sourceChunkCount is int && data.sourceChunkCount >= 0 && data.sourceChunkCount <= 5000
            && data.sourceName is string
            && data.topics is list
            && data.topics.size() > 0
            && data.topics.size() <= 20
            && data.currentTopicIndex is int
            && data.currentTopicIndex >= 0
            && data.currentTopicIndex < data.topics.size()
            && data.completedTopics is list
            && data.completedTopics.size() <= data.topics.size()
            && data.bypassedTopics is list
            && data.bypassedTopics.size() <= data.topics.size()
            && data.status in ['in_progress', 'completed']
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }
        allow read, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && validStudyPlan(request.resource.data);
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && validStudyPlan(request.resource.data);
      }


      match /studyPlans/{planId}/sourceChunks/{chunkId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'index', 'text', 'summary', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'index', 'text', 'summary', 'createdAt'])
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < 5000
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 36000
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 1800
          && request.resource.data.createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /studyPlans/{planId}/conversations/{messageId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'topicId', 'question', 'answer', 'createdAt'])
          && request.resource.data.topicId is string
          && request.resource.data.question is string && request.resource.data.question.size() <= 1200
          && request.resource.data.answer is string && request.resource.data.answer.size() <= 5000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
      match /studyPlans/{planId}/memory/{memoryId} {
        allow read: if isSignedIn() && request.auth.uid == userId && memoryId == 'state';
        allow create, update: if isSignedIn()
          && request.auth.uid == userId && memoryId == 'state'
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'summary', 'strengths', 'weakAreas', 'keyQuestions', 'updatedAt'])
          && request.resource.data.summary is string && request.resource.data.summary.size() <= 3500
          && request.resource.data.strengths is list && request.resource.data.strengths.size() <= 8
          && request.resource.data.weakAreas is list && request.resource.data.weakAreas.size() <= 8
          && request.resource.data.keyQuestions is list && request.resource.data.keyQuestions.size() <= 8
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId && memoryId == 'state';
      }
      match /entitlements/{entitlementId} {
        allow read: if isSignedIn() && request.auth.uid == userId && entitlementId == 'features';
        allow write: if isAdmin();
      }

      match /savedImages/{imageId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.postId is string
          && request.resource.data.imageUrl is string;
      }
    }

    // ─── Private per-user appearance preferences ─────────────────────
    // A user can read and update only their own theme document.
    match /user_preferences/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'theme', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'theme', 'updatedAt'])
        && request.resource.data.theme is map
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    // ─── Private per-user profile details ────────────────────────────
    // Contact and academic details are readable only by their owner.
    match /user_private_profiles/{userId} {
      function validPrivateProfile(data) {
        return data.keys().hasOnly(['uid', 'faculty', 'level', 'phone', 'dateOfBirth', 'updatedAt'])
          && data.keys().hasAll(['uid', 'updatedAt'])
          && data.uid == userId
          && data.updatedAt is int
          && (!('faculty' in data) || (data.faculty is string && data.faculty.size() <= 120))
          && (!('level' in data) || (data.level is string && data.level.size() <= 40))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 24))
          && (!('dateOfBirth' in data) || (data.dateOfBirth is string && data.dateOfBirth.size() == 10));
      }
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validPrivateProfile(request.resource.data);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && resource.data.uid == userId
        && validPrivateProfile(request.resource.data);
      allow delete: if false;
    }

    // ─── Daily quotes ──────────────────────────────────────────────
    // Everyone may read the shared quote cache. Only the admin may
    // generate, refresh, or remove cached quotes.
    match /aqsDailyQuotes/{quoteId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── User feedback questionnaires ──────────────────────────────
    // The active questionnaire is public so the popup can load before
    // authentication. Questionnaire management remains admin-only.
    match /aqsSystem/{settingId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /aqsFeedbacks/{feedbackId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Feedback responses use one top-level collection per questionnaire
    // (aqsFeedbackResponses_<questionnaire id>).
    match /{collectionId}/{responseId} {
      allow create: if collectionId.matches('aqsFeedbackResponses_.*')
          && request.resource.data.feedbackId is string
          && request.resource.data.answers is map
          && request.resource.data.submittedAt is int;
      allow read: if isAdmin()
          && collectionId.matches('aqsFeedbackResponses_.*');
    }

    // ─── App ratings ───────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.comment is string;
      allow read: if isAdmin();
    }

    // ─── Usernames ──────────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin()
          || (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── DaraQuiz Social Profiles ──────────────────────────────────
    match /social_profiles/{uid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ─── StudyCo online presence and last seen ───────────────────────
    match /studyco_presence/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.online is bool;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.online is bool;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ─── Friend Requests ───────────────────────────────────────────
    match /social_friend_requests/{requestId} {
      // A StudyCo profile checks this deterministic document before creating
      // a request. A missing document has no resource.data, so explicitly
      // allow that harmless lookup for signed-in users.
      allow get: if isSignedIn()
          && (resource == null
              || resource.data.requesterId == request.auth.uid
              || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn()
          && (resource.data.requesterId == request.auth.uid
              || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid;
      allow update, delete: if isSignedIn()
          && (resource.data.requesterId == request.auth.uid
              || resource.data.recipientId == request.auth.uid);
    }

    // ─── StudyCo account notifications ─────────────────────────────
    match /studyco_notifications/{notificationId} {
      allow read: if isSignedIn()
          && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid
          && (request.resource.data.type != 'message'
            || (request.resource.data.conversationId is string
              && isChatParticipant(request.resource.data.conversationId, request.resource.data.actorId)
              && isChatParticipant(request.resource.data.conversationId, request.resource.data.recipientId)
              && !isUserBlockedEitherWay(request.resource.data.actorId, request.resource.data.recipientId)
              && !isChatMutedFor(request.resource.data.conversationId, request.resource.data.recipientId)));
      allow update: if isSignedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn()
          && resource.data.recipientId == request.auth.uid;
    }

    // ─── One-to-one Social Conversations ───────────────────────────
    match /social_conversations/{conversationId} {
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
          && request.auth.uid in resource.data.participantIds
          && request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/social_conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/social_conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/social_conversations/$(conversationId)).data.participantIds
          && request.resource.data.receiverId != request.auth.uid
          && !isUserBlockedEitherWay(request.auth.uid, request.resource.data.receiverId)
          && request.resource.data.messageText is string
          && request.resource.data.messageText.size() > 0
          && request.resource.data.messageText.size() <= 2000;
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/social_conversations/$(conversationId)).data.participantIds
          && (
            request.auth.uid == resource.data.senderId
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read', 'readAt'])
              && request.resource.data.is_read == true
            )
          );
        allow delete: if isSignedIn()
          && request.auth.uid == resource.data.senderId;
      }
    }


    // Each user's chat controls are private to that account.
    match /social_chat_settings/{settingId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validChatSettings(settingId, request.resource.data);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && validChatSettings(settingId, request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // A user can inspect and remove only their own block records.
    match /social_user_blocks/{ownerUid}/blocked/{targetUid} {
      allow get, list: if isSignedIn() && request.auth.uid == ownerUid;
      allow create: if isSignedIn()
        && request.auth.uid == ownerUid
        && targetUid != ownerUid
        && request.resource.data.keys().hasOnly(['blockedUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['blockedUid', 'createdAt'])
        && request.resource.data.blockedUid == targetUid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == ownerUid;
    }

    // Reports are private to moderators; reporters can only submit them.
    match /social_chat_reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'conversationId', 'category', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'conversationId', 'category', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.conversationId is string
        && isChatParticipant(request.resource.data.conversationId, request.auth.uid)
        && isChatParticipant(request.resource.data.conversationId, request.resource.data.reportedUserId)
        && request.resource.data.category in ['spam', 'harassment', 'inappropriate', 'threat', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // ─── StudyCo Meet posts ─────────────────────────────────────────
    match /studyco_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
          || (isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likeCount', 'commentCount', 'updatedAt']));
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /likes/{uid} {
        allow read: if true;
        allow create: if isSignedIn() && uid == request.auth.uid;
        allow delete: if isSignedIn() && uid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
            && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin()
            || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // ─── Per-viewer StudyCo post preferences ─────────────────────────
    match /studyco_post_preferences/{preferenceId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.preference in ['interested', 'not_interested'];
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.preference in ['interested', 'not_interested'];
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ─── StudyCo Meet stories ───────────────────────────────────────
    match /studyco_stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && (!('audience' in request.resource.data) || request.resource.data.audience == 'public');
      allow update: if isAdmin()
          || (isSignedIn()
              && resource.data.userId == request.auth.uid
              && (!('audience' in request.resource.data) || request.resource.data.audience == 'public'));
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /studyco_private_stories/{storyId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.audience == 'only_me';
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── StudyCo Meet audio call signaling ──────────────────────────
    match /studyco_calls/{callId} {
      allow read: if isSignedIn()
          && (resource.data.callerId == request.auth.uid
              || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && !isUserBlockedEitherWay(request.auth.uid, request.resource.data.receiverId);
      allow update: if isSignedIn()
          && (resource.data.callerId == request.auth.uid
              || resource.data.receiverId == request.auth.uid);
      allow delete: if isSignedIn()
          && (resource.data.callerId == request.auth.uid
              || resource.data.receiverId == request.auth.uid);

      match /candidates/{candidateId} {
        allow read, create: if isSignedIn()
            && (get(/databases/$(database)/documents/studyco_calls/$(callId)).data.callerId == request.auth.uid
                || get(/databases/$(database)/documents/studyco_calls/$(callId)).data.receiverId == request.auth.uid);
      }
    }

    // ─── Private per-user appearance preferences ────────────────────
    match /user_preferences/{userId} {
      function validUserPreference(data) {
        return data.keys().hasOnly(['uid', 'theme', 'updatedAt'])
          && data.keys().hasAll(['uid', 'theme', 'updatedAt'])
          && data.uid == userId
          && data.theme is map
          && data.updatedAt is int;
      }
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && validUserPreference(request.resource.data);
    }

    // ─── Private academic and contact profile fields ────────────────
    // Phone number and date of birth are never exposed through public profile documents.
    match /user_private_profiles/{userId} {
      function validPrivateProfile(data) {
        return data.keys().hasOnly(['uid', 'faculty', 'level', 'phone', 'dateOfBirth', 'updatedAt'])
          && data.keys().hasAll(['uid', 'updatedAt'])
          && data.uid == userId
          && data.updatedAt is int
          && (!('faculty' in data) || (data.faculty is string && data.faculty.size() <= 120))
          && (!('level' in data) || (data.level is string && data.level.size() <= 40))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 24))
          && (!('dateOfBirth' in data) || (data.dateOfBirth is string && (data.dateOfBirth == '' || (data.dateOfBirth.size() == 10 && data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')))))
    match /settings/{settingId} {
      /* API key pools live in settings/main; reading them requires a real
         signed-in account. Guest (anonymous) sessions, used for multiplayer,
         can never read them. */
      allow read: if isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && settingId != 'private';
      allow write: if isAdmin();
    }

    // API credentials are server-only. The client can never read this
    // document, even though other public app settings remain readable.
    match /settings/private {
      allow read, write: if isAdmin();
    }

    // ─── Ads ────────────────────────────────────────────────────────
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Deleted Quizzes ────────────────────────────────────────────
    match /deleted_quizzes/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Challenges ─────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.host_uid == request.auth.uid)
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Library Books ──────────────────────────────────────────────
    match /library_books/{bookId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uploaderUid == request.auth.uid);
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.uploaderUid == request.auth.uid)
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // ─── Library Profiles ───────────────────────────────────────────
    match /library_profiles/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ─── Library Likes ──────────────────────────────────────────────
    match /library_likes/{likeId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // ─── Library Comments ───────────────────────────────────────────
    match /library_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']));
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Library Replies ────────────────────────────────────────────
    match /library_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Library Follows ────────────────────────────────────────────
    match /library_follows/{followId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // SmartQuiz multiplayer is server-authoritative. Clients can only read
    // an authenticated room and its roster. All writes, including lifecycle,
    // roster, answers, and scores, go through the authenticated Cloud Function.
    match /multiplayerRooms/{roomId} {
      allow get: if isSignedIn()
        && (request.auth.uid == resource.data.hostUid
          || exists(/databases/$(database)/documents/multiplayerRooms/$(roomId)/players/$(request.auth.uid)));
      allow list: if false;
      allow create, update, delete: if false;

      match /players/{playerUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/multiplayerRooms/$(roomId)).data.hostUid
            || exists(/databases/$(database)/documents/multiplayerRooms/$(roomId)/players/$(request.auth.uid)));
        allow create, update, delete: if false;
      }

      match /answers/{answerId} {
        allow read, write: if false;
      }

      match /private/{privateId} {
        allow read, write: if false;
      }

      match /avatarClaims/{avatarId} {
        allow read, write: if false;
      }

      // Voice chat signaling only. Peers exchange WebRTC offers, answers and
      // ICE candidates here. Messages can only be sent between players of the
      // same room, and only the addressed player can read or clear them.
      match /signals/{signalId} {
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['from', 'to', 'kind', 'data', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.kind in ['offer', 'answer', 'ice']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 6000
          && exists(/databases/$(database)/documents/multiplayerRooms/$(roomId)/players/$(request.auth.uid))
          && exists(/databases/$(database)/documents/multiplayerRooms/$(roomId)/players/$(request.resource.data.to));
        allow read, delete: if isSignedIn() && resource.data.to == request.auth.uid;
        allow update: if false;
      }
    }

    // Rate-limit counters for live multiplayer (guests can host and use the AI).
    // Only the Cloud Function reads or writes these.
    match /multiplayerLimits/{limitId} {
      allow read, write: if false;
    }

    // ─── Library Views ──────────────────────────────────────────────
    match /library_views/{viewId} {
      allow read: if isSignedIn();
      allow create: if true;
    }

  }
