rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'daramolapeter98@gmail.com';
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // ─── Quizzes ────────────────────────────────────────────────────
    match /quizzes/{quizId} {
      allow read: if true;
      allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.host_uid == request.auth.uid);
      allow create: if isSignedIn();
    }

    // ─── Attempts ───────────────────────────────────────────────────
    match /attempts/{attemptId} {
      allow create: if true;
      allow read, update, delete: if isAdmin()
          || (isSignedIn() && resource.data.host_uid == request.auth.uid);
    }

    // ─── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ─── Usernames ──────────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin()
          || (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── DaraQuiz Social Profiles ──────────────────────────────────
    match /social_profiles/{uid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ─── Friend Requests ───────────────────────────────────────────
    match /social_friend_requests/{requestId} {
      // A StudyCo profile checks this deterministic document before creating
      // a request. A missing document has no resource.data, so explicitly
      // allow that harmless lookup for signed-in users.
      allow get: if isSignedIn()
          && (resource == null
              || resource.data.requesterId == request.auth.uid
              || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn()
          && (resource.data.requesterId == request.auth.uid
              || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid;
      allow update, delete: if isSignedIn()
          && (resource.data.requesterId == request.auth.uid
              || resource.data.recipientId == request.auth.uid);
    }

    // ─── StudyCo account notifications ─────────────────────────────
    match /studyco_notifications/{notificationId} {
      allow read: if isSignedIn()
          && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid;
      allow update: if isSignedIn()
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn()
          && resource.data.recipientId == request.auth.uid;
    }

    // ─── One-to-one Social Conversations ───────────────────────────
    match /social_conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
          && request.auth.uid in resource.data.participantIds
          && request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/social_conversations/$(conversationId)).data.participantIds;
        allow update, delete: if isSignedIn()
          && request.auth.uid == resource.data.senderId;
      }
    }

    // ─── StudyCo Meet posts ─────────────────────────────────────────
    match /studyco_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
          || (isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likeCount', 'commentCount', 'updatedAt']));
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /likes/{uid} {
        allow read: if true;
        allow create: if isSignedIn() && uid == request.auth.uid;
        allow delete: if isSignedIn() && uid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
            && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin()
            || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // ─── StudyCo Meet stories ───────────────────────────────────────
    match /studyco_stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── StudyCo Meet audio call signaling ──────────────────────────
    match /studyco_calls/{callId} {
      allow read: if isSignedIn()
          && (resource.data.callerId == request.auth.uid
              || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.callerId == request.auth.uid;
      allow update: if isSignedIn()
          && (resource.data.callerId == request.auth.uid
              || resource.data.receiverId == request.auth.uid);
      allow delete: if isSignedIn()
          && (resource.data.callerId == request.auth.uid
              || resource.data.receiverId == request.auth.uid);

      match /candidates/{candidateId} {
        allow read, create: if isSignedIn()
            && (get(/databases/$(database)/documents/studyco_calls/$(callId)).data.callerId == request.auth.uid
                || get(/databases/$(database)/documents/studyco_calls/$(callId)).data.receiverId == request.auth.uid);
      }
    }

    // ─── Settings ───────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Ads ────────────────────────────────────────────────────────
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Deleted Quizzes ────────────────────────────────────────────
    match /deleted_quizzes/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Challenges ─────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.host_uid == request.auth.uid)
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Library Books ──────────────────────────────────────────────
    match /library_books/{bookId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uploaderUid == request.auth.uid);
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.uploaderUid == request.auth.uid)
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // ─── Library Profiles ───────────────────────────────────────────
    match /library_profiles/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ─── Library Likes ──────────────────────────────────────────────
    match /library_likes/{likeId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // ─── Library Comments ───────────────────────────────────────────
    match /library_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']));
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Library Replies ────────────────────────────────────────────
    match /library_replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Library Follows ────────────────────────────────────────────
    match /library_follows/{followId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // ─── Library Views ──────────────────────────────────────────────
    match /library_views/{viewId} {
      allow read: if isSignedIn();
      allow create: if true;
    }

  }
}
