rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Private StudyCo story media is readable only by its owner.
    match /studyco-private/{uid}/stories/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn()
          && request.auth.uid == uid
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // StudyCo Meet public media remains readable by everyone.
    match /studyco/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
          && request.auth.uid == uid
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }
  }
}