rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // StudyCo Meet media is always stored under the owning user's uid.
    // Keep uploads image-only and bounded even though the UI validates too.
    match /studyco/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
          && request.auth.uid == uid
          && request.resource.size < 8 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }
  }
}